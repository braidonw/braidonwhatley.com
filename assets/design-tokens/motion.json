{
  "transition": {
    "$type": "duration",
    "fast": {
      "$value": { "value": 200, "unit": "ms" }
    },
    "normal": {
      "$value": { "value": 250, "unit": "ms" }
    },
    "slow": {
      "$value": { "value": 300, "unit": "ms" }
    },
    "extra-slow": {
      "$value": { "value": 500, "unit": "ms" }
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "in": { "$value": [0.4, 0, 1, 1] },
    "out": { "$value": [0, 0, 0.2, 1] },
    "in-out": { "$value": [0.4, 0, 0.2, 1] },
    "bounce": { "$value": [0.5, 0.05, 0.2, 1.5] }
  }
}
